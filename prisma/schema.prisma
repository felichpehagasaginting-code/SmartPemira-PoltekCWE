// ============================================================
// SMART PEMIRA — POLTEK CWE
// Skema Database Zero-Knowledge Ballot (PRD.md Bab 9 + PROMPT.md Hukum 1-5)
// HUKUM 1: TIDAK ADA relasi voter_id / nim di ballot_boxes & voting_tokens.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- DOMAIN PROGRAM STUDI (Multi-Ballot Color Coding) ----------
model StudyProgram {
  id          String   @id // "BKS" | "TPHP" | "LOGISTIK" | "TRPL"
  name        String
  facultyName String
  colorPrimary String // Hima ballot accent hex
  colorTint    String // Hima ballot soft tint hex
  voters      Voter[]
  candidates  Candidate[]
  votingTokens VotingToken[]
}

// ---------- DOMAIN TPS VIRTUAL (100% Online — satu rantai hash per prodi) ----------
// Pemira 100% online: tidak ada TPS fisik. Setiap prodi memiliki satu
// "TPS virtual" berisi rantai hash suara mandiri (keputusan diskusi 2026-10-20).
model Tps {
  id             String  @id // "TPTP" | "TPHP" | "MANLOG" | "BD" | "TRPL" (= kode prodi)
  name           String // "TPS ONLINE — TPTP" dst.
  location       String // "Pemungutan Online — <nama prodi>"
  chainSalt      String  @unique // salt per rantai untuk ballot hash chaining
  lastChainHash  String  @default("") // head rantai hash SHA-256
  voters         Voter[]
  votingTokens   VotingToken[]
  ballotBoxes    BallotBox[]
}

// ---------- DOMAIN PEMILIH (Voter Identification) ----------
model Voter {
  id              String    @id @default(uuid())
  nim             String    @unique
  name            String
  angkatan        Int
  studyProgramId  String
  studyProgram    StudyProgram @relation(fields: [studyProgramId], references: [id])
  tpsId           String
  tps             Tps       @relation(fields: [tpsId], references: [id])
  status          String    @default("BELUM_MEMILIH") // BELUM_MEMILIH | DALAM_ANTREAN | SUDAH_MEMILIH
  hasVoted        Boolean   @default(false)
  votedAt         DateTime?
  // Sesi token aktif milik pemilih (arah voter→token, TANPA membalik ballot).
  // Hash token aktif yang sedang dipegang; dikosongkan setelah suara terkirim
  // sehingga tidak ada jembatan permanen identitas → suara.
  pendingTokenHash String?
  createdAt       DateTime  @default(now())
}

// ---------- DOMAIN TOKEN Ephemeral (TTL 10 menit utk vote pertama) ----------
// HUKUM 1: Tidak menyimpan voter_id — hanya token_hash + prodi untuk filter surat suara.
// Re-vote model Estonia: setelah USED, token TETAP dapat membuka bilik ulang
// untuk mengganti suara sampai pemungutan ditutup — suara TERAKHIR yang dihitung.
// lockedAt = "Kunci Suaraku" (finalisasi sukarela oleh pemilih) / pencabutan petugas.
model VotingToken {
  id             String    @id @default(uuid())
  tokenHash      String    @unique // SHA-256 dari token plaintext 6 karakter
  tpsId          String
  tps            Tps       @relation(fields: [tpsId], references: [id])
  studyProgramId String
  studyProgram   StudyProgram @relation(fields: [studyProgramId], references: [id])
  status         String    @default("ACTIVE") // ACTIVE | USED | EXPIRED | REVOKED
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime // TTL hanya untuk memasuki bilik PERTAMA kali
  usedAt         DateTime?
  lockedAt       DateTime? // finalisasi sukarela (Kunci Suaraku) — menutup re-vote
  revoteCount    Int       @default(0) // berapa kali suara diganti (0 = sekali vote)
  ballots        BallotBox[]
}

// ---------- DOMAIN SURAT SUARA Anonim (Anonymous Ballots) ----------
// HUKUM 1 & 2: Tanpa identitas. Timestamp di-jitter, UUID acak, hash berantai per rantai.
// tokenId = kredensial ANONIM (kembali ke token tanpa nama) — bukan identitas.
// Diperlukan untuk latest-ballot-wins: dari seluruh versi suara satu token,
// hanya blok dengan voteVersion tertinggi yang dihitung (model Estonia).
// Token REVOKED (dicabut petugas) seluruh bloknya dikecualikan dari rekap.
model BallotBox {
  id           String    @id @default(uuid()) // UUIDv4 acak murni
  category     String // PRESMA | DPM | HIMA
  candidateId  String?
  candidate    Candidate? @relation(fields: [candidateId], references: [id])
  isEmptyBox   Boolean   @default(false)
  tpsId        String
  tps          Tps       @relation(fields: [tpsId], references: [id])
  tokenId      String?
  token        VotingToken? @relation(fields: [tokenId], references: [id])
  voteVersion  Int       @default(1) // versi suara: 1 = pertama, 2+ = hasil re-vote
  createdAt    DateTime  @default(now()) // nilai diisi app dengan jitter acak
  ballotHash   String // SHA-256 chain: prev + id + category + candidate + ts + salt
}

// ---------- DOMAIN KANDIDAT ----------
model Candidate {
  id             String  @id @default(uuid())
  category       String // PRESMA | DPM | HIMA
  studyProgramId String? // hanya untuk HIMA
  studyProgram   StudyProgram? @relation(fields: [studyProgramId], references: [id])
  number         Int // nomor urut
  presidentName  String // DPM: Ketua Umum | BEM: Presma | HIMA: Ketua
  viceName       String? // DPM: Ketua 1 | BEM: Wakil Presma | HIMA: Wakil Ketua
  secondViceName String? // khusus DPM: Ketua 2 (struktur DPM = Ketua Umum + Ketua 1 + Ketua 2)
  // Foto resmi (file statis di /public/candidates) — fallback UI = inisial nama
  photoLeaderUrl       String? // foto presidentName
  photoViceUrl         String? // foto viceName
  photoSecondViceUrl   String? // foto secondViceName (DPM saja)
  vision         String
  missionJson    String // JSON array of strings (SQLite tidak mendukung list)
  photoAccent    String // warna aksen kartu kandidat
  isEmptyBox     Boolean @default(false)
  ballots        BallotBox[]
}

// ---------- DOMAIN AUDIT LOG (append-only, tanpa pilihan kandidat) ----------
model AuditLog {
  id        String   @id @default(uuid())
  event     String // TOKEN_ISSUED | BALLOT_SUBMITTED | TOKEN_EXPIRED | PLENO_UNLOCK | ...
  detail    String // deskripsi TANPA membocorkan pilihan suara
  tpsId     String?
  createdAt DateTime @default(now())
}

// ---------- DOMAIN LAPORAN SENGKETA (FR-08.2) ----------
model ElectionIncident {
  id            String   @id @default(uuid())
  ticketNumber  String   @unique
  reporterName  String
  reporterNim   String
  incidentType  String // PELANGGARAN_KAMPANYE | KECURANGAN_TPS | MALFUNGSI_SISTEM | LAINNYA
  location      String
  description   String
  status        String   @default("SUBMITTED") // SUBMITTED | IN_REVIEW | RESOLVED | REJECTED
  verdict       String?
  createdAt     DateTime @default(now())
}

// ---------- DOMAIN PENGATURAN ELEKSI (FR-01) ----------
model ElectionSetting {
  id              String   @id @default("main")
  votingOpen      Boolean  @default(true)
  emergencyFreeze Boolean  @default(false)
  plenoUnlocked   Boolean  @default(false) // HUKUM 5: Pleno Vault Lock
  plenoUnlockedAt DateTime?
  sessionSecret   String   @default("") // HMAC secret untuk sesi operator (RBAC)
  // Rekomendasi #2: tanda tangan asimetris Ed25519 atas kanonikal BA —
  // kunci privat dipegang sistem penyelenggara, kunci PUBLIK dipublikasikan
  // sehingga siapa pun dapat memverifikasi tanpa rahasia apa pun.
  baSignatureEd25519 String? // base64 signature Ed25519 atas kanonikal BA
  baSignedAt         DateTime? // kapan BA ditandatangani (Pleno Unlock)
  // Siklus hidup pemira — "Segel & Reset": tiap periode/gelombang punya label
  // sendiri; reset periode mengarsipkan lembar lama lalu membuka lembar baru.
  periodLabel     String   @default("Pemira Poltek CWE 2026")
  periodStartedAt DateTime? // kapan lembar periode ini dibuka (setelah reset)
  updatedAt       DateTime @updatedAt
}

// ---------- DOMAIN ARSIP PENUTUPAN PERIODE (Segel & Reset Pemira) ----------
// Append-only TIDAK dilanggar: sebelum rantai di-re-genesis, seluruh lembar
// periode lama disegel ke arsip ini — rekap resmi + kanonikal BA + tanda
// tangan kriptografis + snapshot audit log & sengketa. Arsip tidak pernah
// diedit; hanya bertambah (satu baris per penutupan periode).
model ElectionArchive {
  id             String   @id @default(uuid())
  archiveCode    String   @unique // "ARS-2026-0001"
  periodLabel    String // label periode yang DITUTUP
  mode           String // DEMO (gelombang ulang) | NEW_PERIOD (periode baru total)
  sealedAt       DateTime @default(now())
  sealedBy       String // username ITPO penyegel
  note           String // catatan berita acara penutupan
  summaryJson    String // rekap tally lengkap + totals + integritas rantai
  canonical      String // kanonikal BA C-KWE saat penyegelan
  signature      String // SHA-256 kanonikal (identik dgn BA yang dipublikasi)
  signatureEd25519 String? // Rekomendasi #2: tanda tangan Ed25519 atas kanonikal arsip
  auditLogJson   String // snapshot penuh audit log periode lama (append-only)
  incidentsJson  String // snapshot laporan sengketa
  candidatesJson String // snapshot kandidat (referensi pemulihan periode baru)
  chainHeadsJson String // head kelima rantai prodi saat penyegelan
  dptCount       Int
  votedCount     Int
  ballotCount    Int
}

// ---------- DOMAIN OTENTIKASI PETUGAS (RBAC — PRD Bab 3) ----------
// Hukum 1 tetap berlaku: Operator TIDAK berelasi ke BallotBox/VotingToken.
model Operator {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String // scrypt: salt:hash (hex)
  role         String // KPUM | PPUR | PANWASLU | SAKSI | ITPO
  fullName     String
  tpsId        String? // operator PPUR terikat TPS tertentu (FR-04.1)
  isActive     Boolean  @default(true)
  mustChangePassword Boolean @default(false) // sandi sementara dari reset ITPO — wajib diganti saat login
  // Rekomendasi #3 — 2FA TOTP (RFC 6238). Secret disimpan TERENKRIPSI
  // AES-256-GCM (kunci diturunkan dari sessionSecret); kode cadangan disimpan
  // sebagai hash scrypt sehingga bocornya DB tidak membuka pintu kedua.
  totpPendingSecret String?    // secret base32 sementara — belum terkonfirmasi
  totpSecret        String?    // secret base32 TERENKRIPSI — aktif setelah konfirmasi
  totpEnabledAt     DateTime?  // null = 2FA belum aktif untuk akun ini
  backupCodesJson   String?    // JSON array hash scrypt kode cadangan sekali pakai
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
}
